{
  "id": "MEDEVAC9",
  "version": 1,
  "code": 1,
  "title": "9-Line MEDEVAC Request (representative)",
  "xmlName": "MedicalEvacuationRequest",
  "cotType": "b-r-f-h-c",
  "pointField": "pickupLocation",
  "defaultPrecedence": "IMMEDIATE",
  "fields": [
    { "name": "pickupLocation", "set": "L1", "xml": "PickupLocation", "type": "POSITION",
      "label": "Line 1 - Pickup site location" },
    { "name": "radioFrequency", "set": "L2", "xml": "RadioFrequencyValue", "type": "DECIMAL",
      "scale": 3, "min": 0, "max": 9999, "label": "Line 2 - Radio frequency (MHz)" },
    { "name": "callsign", "set": "L2", "xml": "CallSignText", "type": "TEXT", "max": 12,
      "label": "Line 2 - Call sign and suffix" },
    { "name": "patientsByPrecedence", "set": "L3", "xml": "PatientPrecedenceCount", "type": "COUNTS", "max": 31,
      "label": "Line 3 - Patients by precedence",
      "codes": [ {"code": "A", "label": "Urgent"}, {"code": "B", "label": "Urgent surgical"},
                 {"code": "C", "label": "Priority"}, {"code": "D", "label": "Routine"},
                 {"code": "E", "label": "Convenience"} ] },
    { "name": "specialEquipment", "set": "L4", "xml": "SpecialEquipmentCode", "type": "ENUM_SET",
      "label": "Line 4 - Special equipment required",
      "codes": [ {"code": "A", "label": "None"}, {"code": "B", "label": "Hoist"},
                 {"code": "C", "label": "Extraction equipment"}, {"code": "D", "label": "Ventilator"} ] },
    { "name": "patientsByType", "set": "L5", "xml": "PatientTypeCount", "type": "COUNTS", "max": 31,
      "label": "Line 5 - Patients by type",
      "codes": [ {"code": "L", "label": "Litter"}, {"code": "A", "label": "Ambulatory"} ] },
    { "name": "pickupSecurity", "set": "L6", "xml": "PickupSiteSecurityCode", "type": "ENUM",
      "label": "Line 6 - Security at pickup site",
      "codes": [ {"code": "N", "label": "No enemy troops in area"}, {"code": "P", "label": "Possible enemy troops"},
                 {"code": "E", "label": "Enemy troops in area, approach with caution"},
                 {"code": "X", "label": "Enemy troops in area, armed escort required"} ] },
    { "name": "markingMethod", "set": "L7", "xml": "PickupSiteMarkingCode", "type": "ENUM",
      "label": "Line 7 - Method of marking pickup site",
      "codes": [ {"code": "A", "label": "Panels"}, {"code": "B", "label": "Pyrotechnic signal"},
                 {"code": "C", "label": "Smoke signal"}, {"code": "D", "label": "None"},
                 {"code": "E", "label": "Other"} ] },
    { "name": "patientsByStatus", "set": "L8", "xml": "PatientStatusCount", "type": "COUNTS", "max": 31,
      "label": "Line 8 - Patient nationality and status",
      "codes": [ {"code": "A", "label": "Friendly military"}, {"code": "B", "label": "Friendly civilian"},
                 {"code": "C", "label": "Other military"}, {"code": "D", "label": "Other civilian"},
                 {"code": "E", "label": "Detainee"} ] },
    { "name": "cbrnContamination", "set": "L9", "xml": "CBRNContaminationCode", "type": "ENUM", "required": false,
      "label": "Line 9 - CBRN contamination",
      "codes": [ {"code": "C", "label": "Chemical"}, {"code": "B", "label": "Biological"},
                 {"code": "R", "label": "Radiological"}, {"code": "N", "label": "Nuclear"} ] },
    { "name": "remarks", "set": "RMKS", "xml": "RemarksText", "type": "TEXT", "max": 80, "required": false,
      "label": "Remarks" }
  ]
}
